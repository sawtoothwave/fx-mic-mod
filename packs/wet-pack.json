      "list": [
        {
          "effect": "chorus",
          "max_delay_ms": 50,
          "delay_ms": {
            "block": "lfo",
            "waveform": "sine",
            "rate": 0.3,
            "scale": 8,
            "offset": 18
          },
          "voices": 4,
          "mix": 0.6
