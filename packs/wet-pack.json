        {
          "effect": "freeverb",
          "roomsize": 0.75,
          "damp": 0.4,
          "mix": {
            "block": "math",
            "operation": "constrained_lerp",
            "a": 0.55,
            "b": 0.8,
            "c": "$handle"
          }
        }
      ]
    },
    {
