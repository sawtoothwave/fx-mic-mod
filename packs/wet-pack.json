        {
          "effect": "chorus",
          "max_delay_ms": 50,
          "delay_ms": 20,
          "voices": 3,
          "mix": 0.5
        },
        {
          "effect": "echo",
          "max_delay_ms": 350,
          "delay_ms": 300,
          "decay": {
            "block": "math",
            "operation": "constrained_lerp",
            "a": 0.4,
            "b": 0.7,
            "c": "$handle"
          },
          "mix": 0.35,
          "freq_shift": false
        }
      ]
    },
    {
      "name": "Warble tape",
