    {
      "name": "Bend throw",
      "comment": "Bank 4, crunch. Tape dub's echo, but squeezing shortens the delay from 420 to 250 ms, so the repeats pitch up like tape speeding up, and back down as you ease off.",
      "list": [
        {
          "effect": "echo",
          "max_delay_ms": 500,
          "delay_ms": {
            "block": "math",
            "operation": "constrained_lerp",
            "a": 420,
            "b": 250,
            "c": "$handle"
