          "max_delay_ms": 700,
          "delay_ms": 420,
          "decay": {
            "block": "math",
            "operation": "constrained_lerp",
            "a": 0.5,
            "b": 0.85,
            "c": "$handle"
          },
          "mix": 0.45,
          "freq_shift": true
        }
      ]
    },
    {
      "name": "Crunch slap",
      "comment": "Bank 4, crunch. A gritty 140 ms slap (200 / 140 ms = 1.43x). Squeeze for more repeats.",
      "list": [
        {
          "effect": "echo",
          "max_delay_ms": 200,
          "delay_ms": 140,
          "decay": {
            "block": "math",
            "operation": "constrained_lerp",
            "a": 0.3,
            "b": 0.55,
            "c": "$handle"
          },
          "mix": 0.45,
          "freq_shift": true
        }
      ]
    },
    {
      "name": "Long degrade",
      "comment": "Bank 4, crunch. 600 ms at 1.1x (660 / 600 ms) with long feedback, so it rots over many repeats.",
      "list": [
        {
          "effect": "echo",
          "max_delay_ms": 660,
          "delay_ms": 600,
          "decay": {
            "block": "math",
            "operation": "constrained_lerp",
            "a": 0.6,
            "b": 0.88,
            "c": "$handle"
          },
          "mix": 0.45,
          "freq_shift": true
