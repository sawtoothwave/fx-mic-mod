      "list": [
        {
          "effect": "echo",
          "max_delay_ms": 400,
          "delay_ms": {
            "block": "lfo",
            "waveform": "sine",
            "rate": 0.6,
            "scale": 15,
            "offset": 320
          },
          "decay": {
            "block": "math",
            "operation": "constrained_lerp",
            "a": 0.5,
            "b": 0.8,
            "c": "$handle"
          },
          "mix": 0.45,
          "freq_shift": true
        }
      ]
    },
    {
      "name": "Wide wash",
